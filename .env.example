# Local values from docs/02-01_system-design-doc.md 2章「環境変数」.
# make setup copies this file to .env and fills BETTER_AUTH_SECRET.
# One KEY=value per line; quote values with spaces. The Makefile stops on a $ in a
# value, and on a # or backslash inside quotes.
APP_ENV=local
PORT=3000
DATABASE_URL=postgres://moonx:moonx@localhost:5432/moonx
DATABASE_URL_DIRECT=postgres://moonx:moonx@localhost:5432/moonx
DATABASE_URL_TEST=postgres://moonx:moonx@localhost:5432/moonx_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM="moonx <no-reply@localhost>"
MAIL_ALLOWLIST=
AVATAR_BUCKET=
SENTRY_DSN=
WEB_SENTRY_DSN=
LOG_LEVEL=debug
