{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "local" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "distribution": "store" }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "android": { "buildType": "apk" },
      "ios": { "distribution": "store" }
    }
  },
  "submit": {
    "staging": { "ios": {} },
    "production": { "ios": {} }
  }
}
