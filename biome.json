{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!packages/ui-tokens/src/generated",
      "!apps/api/openapi.json",
      "!docs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/**", "apps/mobile/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@vanilla-extract/css": "Screens take their look from packages/ui-web components (ADR-025).",
                  "@vanilla-extract/recipes": "Screens take their look from packages/ui-web components (ADR-025).",
                  "react-native-unistyles": "Screens take their look from packages/ui-native components (ADR-025).",
                  "react-native": {
                    "importNames": ["StyleSheet"],
                    "message": "Screens take their look from packages/ui-native components (ADR-025)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/tsconfig.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
