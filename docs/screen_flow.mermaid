%% moonx — 画面遷移図
%% Phase 2 の設計仕様書（docs/design-spec.md）と一緒に作成する
%% 番号は design-spec.md の画面番号。M* はモーダル / シート（画面ではない）
%% 共通ナビ（5 / 6 / 10 / 8 のタブと、7 / 4 / 9 / 26 のメニュー）からは、ログイン後のどの画面からでも移れる

graph TD
    %% === 公開・認証 ===
    INV(["招待リンク"])
    S1["1 ランディング"]
    S2["2 ログイン / 新規登録"]
    S3["3 オンボーディング"]

    S1 --> S2
    INV --> S2
    S2 -->|"招待から新規登録 / 既存ユーザーが招待を受ける"| S3
    S3 --> S5
    S2 -->|"ログイン（最後に開いたワークスペース）"| S5

    %% === 共通ナビ（全ロール） ===
    S5["5 ダッシュボード"]
    S6["6 アイデア一覧"]
    S7["7 決定ログ"]
    S8["8 通知"]
    S4["4 アカウント設定"]
    M7{{"M7 ワークスペース切替"}}

    S5 <--> S6
    S5 <--> S8
    S5 --> S7
    S5 --> S4
    S5 --> M7
    M7 --> S5

    %% === Owner ===
    S9["9 ワークスペース設定（Owner）"]
    S5 -->|"Owner のみ"| S9

    %% === 自己分析（本人 / Owner・Member） ===
    S10["10 自己分析ホーム"]
    S11["11 設問フォーム"]
    S12["12 メンバーの自己分析（Owner / Member）"]
    M6{{"M6 共有先の選択"}}

    S5 <-->|"Viewer 以外"| S10
    S10 --> S11
    S11 --> S10
    S10 --> M6
    S5 -->|"共有済みのみ"| S12

    %% === 検証（コアフロー） ===
    M1{{"M1 新しいアイデア"}}
    S13["13 検証ホーム"]
    S14["14 調査ログ"]
    S15["15 競合・代替"]
    S16["16 前提・リスク"]
    S17["17 費用"]
    S18["18 損益・シナリオ"]
    S19["19 判定（Owner / Member）"]
    M2{{"M2 根拠シート"}}

    S6 -->|"Owner / Member"| M1
    M1 --> S13
    S6 --> S13
    S5 --> S13
    S13 -->|"01 / 02 / 10"| S11
    S13 --> S14
    S13 --> S15
    S13 --> S16
    S13 --> S17
    S13 --> S18
    S17 <--> S18
    S11 --> S13
    S11 -.->|"Fact の根拠"| M2
    S15 -.-> M2
    S16 -.-> M2
    S17 -.-> M2
    S18 -.-> M2
    M2 -.->|"新しく記録した根拠は 14 にも残る"| S14
    S13 --> S19
    S19 -->|"Hold / Drop"| S13

    %% === プラン ===
    M5{{"M5 プラン下書きの作成"}}
    S20["20 プランホーム"]
    S21["21 プラン項目の編集"]
    S22["22 実行管理"]
    S23["23 Pitch Deck（1分版 / 5分版）"]
    M3{{"M3 版の保存"}}
    M4{{"M4 Go / No-Go の記録"}}

    S19 -->|"Proceed: プラン下書きを作る"| M5
    S13 -->|"Add plan（最新の判定が Proceed）"| M5
    S20 -->|"Add plan"| M5
    M5 --> S20
    S13 --> S20
    S20 --> S13
    S20 --> S21
    S21 --> S20
    S20 --> S22
    S21 -->|"§23・25・26・28・29"| S22
    S20 --> S23
    S23 -->|"Edit source"| S21
    S20 --> M3
    S20 --> M4
    S21 -->|"引き継いだ数字を直す"| S17
    S21 -->|"引き継いだ数字を直す"| S18

    %% === AI 往復（Owner / Member、自己分析は本人） ===
    S24["24 AI 書き出し"]
    S25["25 AI 取り込み"]
    EXT(["外部の AI（ChatGPT・Claude など）"])

    S10 --> S24
    S11 --> S24
    S13 --> S24
    S20 --> S24
    S21 --> S24
    S24 -.-> EXT
    EXT -.->|"返答を貼り付け"| S25
    S24 -->|"Import from AI"| S25
    S25 -->|"反映後、書き出し元へ戻る"| S10
    S25 --> S11
    S25 --> S13
    S25 --> S20
    S25 --> S21

    %% === 通知・決定ログからの移動 ===
    S8 -->|"該当箇所へ"| S13
    S8 -->|"該当箇所へ"| S20
    S8 -->|"期限"| S22
    S8 -->|"自己分析へのコメント"| S10
    S8 -->|"共有された自己分析へのコメント"| S12
    S7 --> S13
    S7 --> S20

    %% === 運営者（Admin） ===
    S26["26 管理: テンプレート一覧"]
    S27["27 管理: テンプレート編集"]
    S28["28 管理: ユーザーとワークスペース"]

    S5 -->|"Admin のみ"| S26
    S26 --> S27
    S26 --> S28
    S28 <--> S26
