%% moonx — 画面遷移図
%% Phase 2 の設計仕様書（docs/design-spec.md）と一緒に作成する
%% 番号は design-spec.md の画面番号。M* はモーダル / シート（画面ではない）
%% 省略している遷移:
%%   - 共通ナビ（タブ: 5 / 6 / 10 / 8、メニュー: 7 / M7 / 4 / 9 / 26）からは、ログイン後のどの画面からでも移れる
%%   - 14〜18 と 11（検証の設問）は、ヘッダーのセクション切替で互いに移れ、どれからも 13 へ戻れる
%%   - パネル（コメント PNL-1・変更履歴 PNL-2）は各画面の上に開くだけなので描かない
%% 権限: [OM] = Owner / Member のみ、[O] = Owner のみ、[A] = Admin のみ、[本人] = 自己分析の持ち主のみ

graph TD
    %% === 公開・認証 ===
    INV(["招待リンク"])
    S1["1 ランディング"]
    S2["2 ログイン / 新規登録"]
    S3["3 オンボーディング"]

    S1 --> S2
    INV --> S2
    S2 -->|"招待から新規登録 / 既存ユーザーが招待を受ける"| S3
    S3 --> S5
    S2 -->|"ログイン（最後に開いたワークスペース）"| S5

    %% === 共通ナビ（全ロール） ===
    S5["5 ダッシュボード"]
    S6["6 アイデア一覧"]
    S7["7 決定ログ"]
    S8["8 通知"]
    S4["4 アカウント設定"]
    M7{{"M7 ワークスペース切替"}}

    S5 <--> S6
    S5 <--> S8
    S5 --> S7
    S5 --> S4
    S5 --> M7
    M7 -->|"切替 / New workspace（作った人が Owner）"| S5

    %% === Owner ===
    S9["9 ワークスペース設定 [O]"]
    S5 -->|"[O]"| S9

    %% === 自己分析 ===
    S10["10 自己分析ホーム [本人]"]
    S11["11 設問フォーム"]
    S12["12 メンバーの自己分析 [OM]"]
    M6{{"M6 共有先の選択"}}

    S5 <-->|"Viewer として開いているときは出さない"| S10
    S10 --> S11
    S11 --> S10
    S10 -->|"完了後"| M6
    S10 -->|"Team [OM]"| S12
    S5 -->|"共有済みのみ [OM]"| S12

    %% === 検証（コアフロー） ===
    M1{{"M1 新しいアイデア [OM]"}}
    S13["13 検証ホーム"]
    S14["14 調査ログ"]
    S15["15 競合・代替"]
    S16["16 前提・リスク"]
    S17["17 費用"]
    S18["18 損益・シナリオ"]
    S19["19 判定 [OM]"]
    M2{{"M2 根拠シート [OM]"}}

    S6 -->|"[OM]"| M1
    S5 -->|"Getting started [OM]"| M1
    M1 --> S13
    S6 --> S13
    S5 --> S13
    S13 -->|"01 / 02 / 10"| S11
    S13 --> S14
    S13 --> S15
    S13 --> S16
    S13 --> S17
    S13 --> S18
    S13 -->|"See all"| S7
    S17 <--> S18
    S11 --> S13
    S14 --> S13
    S15 --> S13
    S16 --> S13
    S17 --> S13
    S18 --> S13
    S11 -.->|"Fact の根拠"| M2
    S15 -.-> M2
    S16 -.-> M2
    S17 -.-> M2
    S18 -.-> M2
    M2 -.->|"新しく記録した根拠は 14 にも残る"| S14
    S13 -->|"[OM]"| S19
    S19 -->|"Hold / Drop、Cancel、Later"| S13

    %% === プラン ===
    M5{{"M5 プラン下書きの作成 [OM]"}}
    S20["20 プランホーム"]
    S21["21 プラン項目の編集"]
    S22["22 実行管理"]
    S23["23 Pitch Deck（1分版 / 5分版）"]
    M3{{"M3 版の保存 [OM]"}}
    M4{{"M4 Go / No-Go の記録 [OM]"}}

    S19 -->|"Proceed: プラン下書きを作る"| M5
    S13 -->|"Add plan（最新の判定が Proceed）[OM]"| M5
    S20 -->|"Add plan（最新の判定が Proceed）[OM]"| M5
    M5 --> S20
    S13 --> S20
    S20 --> S13
    S20 --> S21
    S21 --> S20
    S20 --> S22
    S21 -->|"Open in Execution（§23・25・26・28・29）"| S22
    S20 --> S23
    S23 -->|"Edit source [OM]"| S21
    S23 -->|"Edit in validation [OM]"| S18
    S23 -->|"Edit in validation [OM]"| S17
    S20 -->|"[OM]"| M3
    S20 -->|"[OM]"| M4
    S21 -->|"引き継いだ数字を直す [OM]"| S17
    S21 -->|"引き継いだ数字を直す [OM]"| S18

    %% === テンプレートの移行 ===
    M8{{"M8 テンプレートの移行 [OM / 本人]"}}
    S10 -->|"新しい版があるとき [本人]"| M8
    S13 -->|"新しい版があるとき [OM]"| M8
    S20 -->|"新しい版があるとき [OM]"| M8
    M8 -.->|"元の画面へ戻る"| S10
    M8 -.-> S13
    M8 -.-> S20

    %% === AI 往復（[OM]、自己分析は [本人]） ===
    S24["24 AI 書き出し"]
    S25["25 AI 取り込み"]
    EXT(["外部の AI（ChatGPT・Claude など）"])

    S10 -->|"Export"| S24
    S11 -->|"Export"| S24
    S13 -->|"Export"| S24
    S20 -->|"Export"| S24
    S21 -->|"Export"| S24
    S24 -.-> EXT
    EXT -.->|"返答を貼り付け"| S25
    S24 -->|"Import from AI"| S25
    S10 -->|"Import"| S25
    S11 -->|"Import"| S25
    S13 -->|"Import"| S25
    S20 -->|"Import"| S25
    S21 -->|"Import"| S25
    S25 -.->|"Fact を付け直す"| M2
    S25 -->|"反映後、入ってきた画面へ戻る"| S10
    S25 --> S11
    S25 --> S13
    S25 --> S20
    S25 --> S21

    %% === 通知・決定ログからの移動 ===
    S8 -->|"該当箇所へ"| S13
    S8 -->|"該当箇所へ"| S20
    S8 -->|"期限"| S22
    S8 -->|"自己分析へのコメント"| S10
    S8 -->|"共有された自己分析へのコメント"| S12
    S7 --> S13
    S7 --> S20

    %% === 運営者（Admin） ===
    S26["26 管理: テンプレート一覧 [A]"]
    S27["27 管理: テンプレート編集 [A]"]
    S28["28 管理: ユーザーとワークスペース [A]"]

    S5 -->|"[A]"| S26
    S26 <--> S27
    S26 <-->|"管理メニューのタブ"| S28
